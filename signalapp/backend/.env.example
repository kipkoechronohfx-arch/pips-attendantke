# =====================================================================
# FOREX SIGNAL PRO — ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. APPLICATION
PROJECT_NAME="Forex Signal Pro API"
VERSION="2.0.0"
APP_ENV="production"
SECRET_KEY="replace-this-with-a-random-64-char-hex-key-in-production"
DEFAULT_TIMEZONE="Africa/Nairobi"
PRIMARY_CURRENCY="USD"

# 2. DATABASE & CACHE
# Default is local SQLite for instant zero-dependency execution.
# For production PostgreSQL / Supabase, uncomment below:
DATABASE_URL="sqlite:///./forex_signal_pro.db"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# REDIS_URL="redis://localhost:6379/0"

# 3. SUPABASE (OPTIONAL: For cloud auth & real-time sync)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. LIVE MARKET DATA PROVIDER (FOREX & METALS)
# Options:
#  - "mock"       : High-fidelity quantitative tick engine (no external API key needed)
#  - "twelvedata" : Twelve Data Live API (Real-time Forex & Commodities)
MARKET_DATA_PROVIDER="mock"
TWELVE_DATA_API_KEY=""

# 5. LIVE FINANCIAL NEWS PROVIDER
# Options: "mock", "gnews"
NEWS_PROVIDER="mock"
GNEWS_API_KEY=""

# 6. ECONOMIC CALENDAR PROVIDER
# Options: "external" (ForexFactory / TradingEconomics RSS), "mock"
ECONOMIC_CALENDAR_PROVIDER="external"
TRADING_ECONOMICS_KEY=""

# 7. FIREBASE CLOUD MESSAGING (OPTIONAL: Mobile Push Notifications)
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
